{
	"name": "web-searching",
	"version": "1.0.0",
	"type": "module",
	"description": "Headless web search via Brave Search - no browser required",
	"author": "Mario Zechner",
	"license": "MIT",
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"jsdom": "^27.0.1",
		"turndown": "^7.2.2",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@mariozechner/pi-coding-agent": "^0.68.0",
		"@sinclair/typebox": "^0.34.49",
		"@vitest/coverage-v8": "^4.1.4",
		"oxlint": "^1.61.0",
		"vitest": "^4.1.4"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "oxlint . --ignore-pattern node_modules --ignore-pattern reports",
		"check": "npm run lint && npm run test:coverage"
	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": "*",
		"@sinclair/typebox": "*"
	}
}
