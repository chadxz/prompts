#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIRECTORY="$(
  cd "$(dirname "$0")"
  pwd -P
)"
RESOLVER="$SCRIPT_DIRECTORY/resolve-worktree"
TEST_ROOT="$(mktemp -d -t resolve-worktree.XXXXXX)"
TEST_ROOT="$(
  cd "$TEST_ROOT"
  pwd -P
)"

cleanup() {
  rm -rf "$TEST_ROOT"
}
trap cleanup EXIT

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

assert_json() {
  local document="$1"
  local expression="$2"
  local message="$3"
  shift 3

  if ! jq -e "$@" "$expression" >/dev/null <<<"$document"; then
    echo "$document" >&2
    fail "$message"
  fi
}

run_expect_exit() {
  local expected_exit_code="$1"
  shift

  set +e
  COMMAND_OUTPUT="$("$@" 2>&1)"
  COMMAND_EXIT_CODE=$?
  set -e

  if [ "$COMMAND_EXIT_CODE" -ne "$expected_exit_code" ]; then
    echo "$COMMAND_OUTPUT" >&2
    fail "expected exit $expected_exit_code, received $COMMAND_EXIT_CODE"
  fi
}

require_command() {
  local command_name="$1"

  command -v "$command_name" >/dev/null 2>&1 ||
    fail "required test command not found: $command_name"
}

require_command git
require_command jq

BARE_CONTAINER="$TEST_ROOT/example"
SEED_REPOSITORY="$TEST_ROOT/seed"
mkdir -p "$BARE_CONTAINER"

git init --quiet "$SEED_REPOSITORY"
git -C "$SEED_REPOSITORY" config user.name "Resolver Test"
git -C "$SEED_REPOSITORY" config user.email "resolver@example.com"
echo "initial" >"$SEED_REPOSITORY/example.txt"
git -C "$SEED_REPOSITORY" add example.txt
git -C "$SEED_REPOSITORY" commit --quiet -m "Initial commit"
git -C "$SEED_REPOSITORY" branch -M main

git init --quiet --bare "$BARE_CONTAINER/.git"
git -C "$SEED_REPOSITORY" remote add origin "$BARE_CONTAINER/.git"
git -C "$SEED_REPOSITORY" push --quiet --set-upstream origin main
git --git-dir="$BARE_CONTAINER/.git" symbolic-ref HEAD refs/heads/main
git --git-dir="$BARE_CONTAINER/.git" symbolic-ref \
  refs/remotes/origin/HEAD refs/remotes/origin/main

MAIN_WORKTREE="$BARE_CONTAINER/main"
TASK_WORKTREE="$BARE_CONTAINER/example-task"
git --git-dir="$BARE_CONTAINER/.git" worktree add --quiet \
  "$MAIN_WORKTREE" main
git --git-dir="$BARE_CONTAINER/.git" worktree add --quiet \
  -b agent/example-task "$TASK_WORKTREE" main

READ_RESULT="$(
  "$RESOLVER" \
    --repo "$BARE_CONTAINER" \
    --main \
    --mode read
)"
# shellcheck disable=SC2016
assert_json "$READ_RESULT" \
  '.resolved and .worktree == $worktree and .is_main' \
  "read mode did not resolve the main worktree" \
  --arg worktree "$MAIN_WORKTREE"

PATH_RESULT="$(
  "$RESOLVER" \
    --repo "$BARE_CONTAINER" \
    --branch agent/example-task \
    --mode write \
    --format path
)"
[ "$PATH_RESULT" = "$TASK_WORKTREE" ] ||
  fail "path output did not return the task worktree"

TASK_RESULT="$(
  "$RESOLVER" \
    --cwd "$TASK_WORKTREE" \
    --mode write
)"
assert_json "$TASK_RESULT" \
  '.resolved and .resolution == "current-worktree" and
    .branch == "agent/example-task" and (.is_main | not)' \
  "write mode did not keep the current task worktree"

run_expect_exit 2 \
  "$RESOLVER" \
  --cwd "$MAIN_WORKTREE" \
  --mode write
assert_json "$COMMAND_OUTPUT" \
  '.resolved == false and .reason == "main-worktree-for-write"' \
  "write mode did not reject the main worktree"

run_expect_exit 2 \
  "$RESOLVER" \
  --repo "$BARE_CONTAINER" \
  --branch agent/missing \
  --mode write
assert_json "$COMMAND_OUTPUT" \
  '.resolved == false and .reason == "no-matching-worktree" and
    .suggested_worktree != null' \
  "missing branch did not return a creation hint"

echo "uncommitted" >"$TASK_WORKTREE/uncommitted.txt"
DIRTY_RESULT="$(
  "$RESOLVER" \
    --repo "$BARE_CONTAINER" \
    --branch agent/example-task \
    --mode write
)"
assert_json "$DIRTY_RESULT" \
  '.resolved and .dirty' \
  "dirty worktree was reported as clean"

NORMAL_REPOSITORY="$TEST_ROOT/normal"
git init --quiet --initial-branch=main "$NORMAL_REPOSITORY"
git -C "$NORMAL_REPOSITORY" config user.name "Resolver Test"
git -C "$NORMAL_REPOSITORY" config user.email "resolver@example.com"
echo "normal" >"$NORMAL_REPOSITORY/example.txt"
git -C "$NORMAL_REPOSITORY" add example.txt
git -C "$NORMAL_REPOSITORY" commit --quiet -m "Initial commit"
NORMAL_RESULT="$(
  "$RESOLVER" \
    --repo "$NORMAL_REPOSITORY" \
    --main \
    --mode read
)"
# shellcheck disable=SC2016
assert_json "$NORMAL_RESULT" \
  '.resolved and .worktree == $worktree and .is_main' \
  "normal repository did not resolve its default worktree" \
  --arg worktree "$NORMAL_REPOSITORY"

FAKE_BIN="$TEST_ROOT/bin"
mkdir -p "$FAKE_BIN"
cat >"$FAKE_BIN/gh" <<EOF
#!/usr/bin/env bash
printf '{"headRefName":"agent/example-task","headRefOid":"%s"}\n' \
  "$(git -C "$TASK_WORKTREE" rev-parse HEAD)"
EOF
chmod +x "$FAKE_BIN/gh"

git --git-dir="$BARE_CONTAINER/.git" remote add \
  origin https://github.com/example/example.git

TEST_HOME="$TEST_ROOT/home"
mkdir -p "$TEST_HOME/src/personal"
ln -s "$BARE_CONTAINER" "$TEST_HOME/src/personal/example"
SLUG_RESULT="$(
  WORKTREE_SOURCE_ROOT="$TEST_HOME/src" \
    "$RESOLVER" \
      --repo example/example \
      --branch agent/example-task \
      --mode write
)"
assert_json "$SLUG_RESULT" \
  '.resolved and .repository == "example/example" and
    .branch == "agent/example-task"' \
  "repository slug did not resolve through the local source layout"

PR_RESULT="$(
  PATH="$FAKE_BIN:$PATH" \
    "$RESOLVER" \
      --repo "$BARE_CONTAINER" \
      --pr example/example#123 \
      --mode write
)"
assert_json "$PR_RESULT" \
  '.resolved and .resolution == "matched-pr-branch" and
    .repository == "example/example" and
    .pull_request_number == "123" and
    .head_matches_expected == true' \
  "pull request resolution did not match the expected branch and SHA"

echo "PASS: resolve-worktree"
