{
	"name": "pi-web",
	"version": "1.0.0",
	"type": "module",
	"pi": {
		"extensions": ["./pi-web.ts"]
	},
	"description": "Headless web search via Brave Search - no browser required",
	"author": {
		"name": "Chad McElligott"
	},
	"license": "MIT",
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"jsdom": "^29.0.2",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chadxz/prompts.git"
	},
	"devDependencies": {
		"@mariozechner/pi-coding-agent": "^0.69.0",
		"@sinclair/typebox": "^0.34.49",
		"@vitest/coverage-v8": "^4.1.5",
		"oxlint": "^1.61.0",
		"vitest": "^4.1.5"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "oxlint . --ignore-pattern node_modules --ignore-pattern reports",
		"check": "npm run lint && npm run test:coverage"
	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": "*",
		"@sinclair/typebox": "*"
	}
}
