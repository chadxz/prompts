#!/usr/bin/env bash
# Keep a `claude remote-control` server running under launchd so new Claude
# Code sessions can be started on this Mac from claude.ai/code or the Claude
# mobile app.
set -euo pipefail

PROMPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LAUNCH_AGENT_LABEL="com.chad.claude-remote-control"
LAUNCH_AGENT_PLIST="$HOME/Library/LaunchAgents/$LAUNCH_AGENT_LABEL.plist"
LOG_FILE="$HOME/Library/Logs/claude-remote-control.log"
# Sessions start in the home directory and move into repositories as needed.
WORK_DIR="${CLAUDE_REMOTE_CONTROL_DIR:-$HOME}"
AGENT_PATH="$PROMPTS_DIR/bin:$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

usage() {
  cat <<EOF
Usage: $(basename "$0") <install|uninstall|run|status>

  install    Write and load the launchd agent (macOS only)
  uninstall  Unload and remove the launchd agent
  run        Run the Remote Control server in the foreground (used by launchd)
  status     Show the launchd job state and recent log output
EOF
}

# Remote Control asks for consent once and records it in ~/.claude.json.
# launchd has no terminal to answer that prompt, so it must already be accepted.
remote_control_consented() {
  [[ -f "$HOME/.claude.json" ]] &&
    [[ "$(jq -r '.remoteDialogSeen // false' "$HOME/.claude.json")" == "true" ]]
}

install_launch_agent() {
  if [[ "$(uname -s)" != Darwin ]]; then
    echo "Skipping Claude Remote Control agent (macOS only)"
    return 0
  fi

  if ! command -v jq >/dev/null 2>&1; then
    echo "Error: jq is required to install the Claude Remote Control agent" >&2
    return 1
  fi

  mkdir -p "$(dirname "$LAUNCH_AGENT_PLIST")" "$(dirname "$LOG_FILE")" "$WORK_DIR"

  cat > "$LAUNCH_AGENT_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LAUNCH_AGENT_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$PROMPTS_DIR/bin/claude-remote-control-agent</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$WORK_DIR</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$AGENT_PATH</string>
    <key>CLAUDE_REMOTE_CONTROL_DIR</key>
    <string>$WORK_DIR</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>$LOG_FILE</string>
</dict>
</plist>
EOF

  plutil -lint "$LAUNCH_AGENT_PLIST" >/dev/null
  echo "Wrote $LAUNCH_AGENT_PLIST"

  local domain
  domain="gui/$(id -u)"
  launchctl bootout "$domain" "$LAUNCH_AGENT_PLIST" >/dev/null 2>&1 || true

  if ! remote_control_consented; then
    echo "Warning: Remote Control has not been enabled for this account yet." >&2
    echo "Run \`claude remote-control\` once in a terminal, answer y, press" >&2
    echo "Ctrl+C, then rerun \`$(basename "$0") install\`." >&2
    return 0
  fi

  launchctl bootstrap "$domain" "$LAUNCH_AGENT_PLIST"
  launchctl kickstart -k "$domain/$LAUNCH_AGENT_LABEL" >/dev/null 2>&1 || true
  echo "Installed Claude Remote Control agent for $WORK_DIR (log: $LOG_FILE)"
}

uninstall_launch_agent() {
  launchctl bootout "gui/$(id -u)" "$LAUNCH_AGENT_PLIST" >/dev/null 2>&1 || true
  rm -f "$LAUNCH_AGENT_PLIST"
  echo "Removed Claude Remote Control agent"
}

# `caffeinate -s` keeps the Mac awake only while it is on AC power, so the
# server stays reachable at a desk without draining the battery on the go.
run_server() {
  cd "$WORK_DIR"
  exec /usr/bin/caffeinate -s claude remote-control --spawn same-dir </dev/null
}

show_status() {
  launchctl print "gui/$(id -u)/$LAUNCH_AGENT_LABEL" 2>/dev/null |
    grep -E '^\s*(state|pid|last exit code|runs) =' || echo "Agent is not loaded"
  if [[ -f "$LOG_FILE" ]]; then
    echo "--- $LOG_FILE"
    tail -n 20 "$LOG_FILE"
  fi
}

main() {
  case "${1:-}" in
    install) install_launch_agent ;;
    uninstall) uninstall_launch_agent ;;
    run) run_server ;;
    status) show_status ;;
    -h | --help | help) usage ;;
    *)
      usage >&2
      exit 64
      ;;
  esac
}

main "$@"
