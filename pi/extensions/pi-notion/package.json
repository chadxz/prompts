{
  "name": "pi-notion",
  "version": "2.2.1",
  "description": "Notion API extension for pi — read, search, and manage Notion pages, databases, and content",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "ai",
    "notion",
    "productivity"
  ],
  "type": "module",
  "files": [
    "extensions/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-notion-mcp.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "portfinder": "^1.0.38"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chadxz/prompts.git",
    "directory": "src/personal/prompts/pi/extensions/pi-notion"
  },
  "author": {
    "name": "Chad McElligott"
  },
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware . --ignore-pattern node_modules --ignore-pattern reports",
    "check": "npm run lint && npm run test"
  },
  "devDependencies": {
    "@sinclair/typebox": "*",
    "@types/node": "^25.6.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.21.1",
    "vitest": "^4.1.5"
  }
}
